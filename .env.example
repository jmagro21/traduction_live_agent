# Copiez en .env (ignore par Git). Priorite : options --xxx > variables d'environnement > ce fichier.

# --- Live Server (laisser les deux vides = pas de diffusion) ---
LIVE_SERVER=https://mon-serveur.exemple
# Meme valeur que LIVE_API_KEY dans le .env utilise par Docker Compose.
LIVE_API_KEY=change-moi-cle-secrete

# --- Reconnaissance vocale ---
# auto (Whisper si GPU NVIDIA, sinon Vosk) | vosk | google | whisper
TRANSLATE_ENGINE=whisper
# Langue parlee
TRANSLATE_LANGUAGE=fr
# Index du micro (python main.py --list-devices). Vide = micro par defaut.
TRANSLATE_MIC_DEVICE=
# Seuil de detection de la voix (google/whisper)
TRANSLATE_THRESHOLD=0.015

# --- Whisper ---
# tiny | base | small | medium | large-v3 (plus gros = bien plus precis)
WHISPER_MODEL=large-v3
# auto | cuda | cpu
WHISPER_DEVICE=auto
WHISPER_GPU_INDEX=0
# Precision de la phrase finale (plus haut = plus lent)
WHISPER_BEAM_FINAL=5

# --- Vosk ---
# Vide = models/vosk-model-small-fr-0.22
VOSK_MODEL=

# --- Affichage ---
TRANSLATE_FONT_SIZE=40
# true = sans fenetre
TRANSLATE_HEADLESS=false
